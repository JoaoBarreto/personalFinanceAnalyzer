# Copiar para .env e preencher. Nunca fazer commit do .env.
# A ligação à BD é construída destas variáveis (a password pode ter caracteres especiais).
POSTGRES_DB=pfa
POSTGRES_USER=pfa
POSTGRES_PASSWORD=change-me

# Cookie de sessão Secure (HTTPS via tailscale serve). Pôr false só em dev com http.
COOKIE_SECURE=true
# IPs de proxies de confiança para ler X-Forwarded-For (ex.: o nginx do compose)
TRUSTED_PROXIES=

# Porta no host (só 127.0.0.1) onde o nginx escuta; é a que se passa ao `tailscale serve`.
FRONTEND_PORT=8080
