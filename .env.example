# Copiar para .env e preencher. Nunca fazer commit do .env.
# A ligação à BD é construída destas variáveis (a password pode ter caracteres especiais).
# Nome do projeto Compose: isola contentores e volumes (duas instâncias lado a lado precisam de nomes diferentes
# e de pastas diferentes). O scripts/install.sh preenche-o; sem esta linha usa o nome da pasta.
# COMPOSE_PROJECT_NAME=pfa
POSTGRES_DB=pfa
POSTGRES_USER=pfa
POSTGRES_PASSWORD=change-me

# Cookie de sessão: auto = Secure só quando o acesso é por HTTPS (tailscale serve); true/false forçam.
COOKIE_SECURE=auto
# IPs de proxies de confiança para ler X-Forwarded-For (ex.: o nginx do compose)
TRUSTED_PROXIES=

# Porta no host (só 127.0.0.1) onde o nginx escuta; é a que se passa ao `tailscale serve`.
FRONTEND_PORT=8080

# Acesso direto pela rede de casa (opcional, sem Tailscale): IP do mini-PC na LAN. Só é usado com
#   docker compose -f docker-compose.yml -f docker-compose.lan.yml up -d --build
# Por omissão a app NÃO fica exposta na rede local (só em 127.0.0.1, via tailscale serve).
LAN_BIND_IP=
